6:["$","li",null,{"children":[["$","strong",null,{"children":"For Service Providers (Background Location):"}]," We collect location data in the background (even when the app is closed or not in use) when you are marked as \"Online\" or \"Available\". This is strictly required to connect you with nearby clients in real-time. Background location tracking stops immediately when you go offline."]}]
7:["$","h3",null,{"children":"2.3 Camera and Media"}]
8:["$","p",null,{"children":"We request access to your device's camera and photo library for the following purposes:"}]
9:["$","ul",null,{"children":[["$","li",null,{"children":"To allow you to upload a profile picture."}],["$","li",null,{"children":"To allow service providers to upload photos to their portfolio."}],["$","li",null,{"children":"To share images in real-time chat with other users."}]]}]
a:["$","h3",null,{"children":"2.4 Push Notifications"}]
b:["$","p",null,{"children":"We request permission to send you push notifications to alert you of new gig requests, messages, and status updates regarding your bookings."}]
c:["$","h2",null,{"children":"3. How We Use Your Information"}]
d:["$","p",null,{"children":"We use the information we collect for various business purposes, including:"}]
e:["$","ul",null,{"children":[["$","li",null,{"children":"Facilitating account creation and logon processes."}],["$","li",null,{"children":"Connecting clients with nearby service providers based on real-time location."}],["$","li",null,{"children":"Verifying user identities to maintain a secure marketplace."}],["$","li",null,{"children":"Providing real-time chat and communication features."}],["$","li",null,{"children":"Sending administrative information, such as terms updates and booking confirmations."}]]}]
f:["$","h2",null,{"children":"4. Sharing Your Information"}]
10:["$","p",null,{"children":"We do not sell your personal data. We only share information with third parties in the following situations:"}]
11:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Other Users:"}]," When you book a gig or accept a request, necessary details (like your name, profile photo, and approximate location) are shared with the other party to facilitate the service."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Service Providers (Firebase):"}]," We use Firebase (by Google) for authentication, database hosting (Firestore), file storage, and push notifications. Your data is securely processed by these infrastructure providers."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Legal Obligations:"}]," We may disclose your information where we are legally required to do so to comply with applicable law, governmental requests, or a judicial proceeding."]}]]}]
12:["$","h2",null,{"children":"5. Data Retention and Deletion"}]
13:["$","p",null,{"children":"We will only keep your personal information for as long as it is necessary for the purposes set out in this privacy policy, unless a longer retention period is required or permitted by law."}]
14:["$","p",null,{"children":"You have the right to request the deletion of your account and all associated data at any time. When you request deletion, we will permanently remove your profile, location history, and media from our active databases."}]
15:["$","p",null,{"children":["To delete your account and data, please visit our ",["$","a",null,{"href":"/delete-account","children":"Account Deletion Page"}],"."]}]
16:["$","h2",null,{"children":"6. Contact Us"}]
17:["$","p",null,{"children":"If you have any questions or comments about this policy, you may contact us via the Support section in the Gigz mobile application, or email us at privacy@gigz-app.com."}]
